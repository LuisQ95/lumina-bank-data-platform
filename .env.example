# Copia este archivo como .env y ajusta los valores. .env no se sube al repositorio.

# Proyecto y región de Google Cloud
GCP_PROJECT=lumina-bank-utec-2026
GCP_REGION=us-central1

# Credenciales: lo recomendado es `gcloud auth application-default login`.
# Si usas una cuenta de servicio, apunta a su llave JSON (nunca la subas al repositorio):
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/a/llave.json

# Carpetas locales (por defecto: data/ y reports/ dentro del repositorio)
# LUMINA_DATA_DIR=./data
# LUMINA_REPORTS_DIR=./reports

# Sal del token SHA-256 de clientes en el pipeline SQL
LUMINA_SALT=demo-utec-2026

# Opcionales
# GCLOUD_BIN=C:/Users/<usuario>/AppData/Local/Google/Cloud SDK/google-cloud-sdk/bin/gcloud.cmd
# LUMINA_SPARK_PYTHON=C:/ruta/al/python/del/entorno/spark
# LUMINA_BUCKET_LANDING=lumina-bank-landing-lumina-bank-utec-2026
# LUMINA_BUCKET_BRONZE=lumina-bank-bronze-lumina-bank-utec-2026
